---
import type { Project } from "../types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group w-full py-3 first:pt-0 last:pb-0">
  <div class="space-y-1">
    <a
      href={project.url}
      class="inline-flex items-center gap-2 font-dm-mono text-base text-neutral-800 hover:text-accent transition-colors"
      target="_blank"
      rel="noopener noreferrer"
    >
      {project.name}
      <span class="text-neutral-300 group-hover:text-accent-light transition-colors">→</span>
    </a>
    <p class="text-sm text-neutral-500">
      {project.description}
    </p>
  </div>
</article>
